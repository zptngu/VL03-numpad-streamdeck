#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define NUMPAD 0
#define FUNC   1

/ {
    combos {
        compatible = "zmk,combos";

        // Encoder switch (position 3) + the "0" key (position 10) toggles the
        // Function layer. Because it is active on both layers, the same chord
        // switches back to the Numpad layer again.

        combo_func_toggle {
            timeout-ms = <50>;
            key-positions = <3 10>;
            bindings = <&tog 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------------
        //  Layer 0 - Numpad
        //   7   8   9   (mute / encoder switch)
        //   4   5   6
        //   1   2   3   0
        //  Encoder rotate = volume down / up
        // ------------------------------------------------------------------
        // ------------------------------------------------------------------
        //  Layer 1 - Function (F13-F21)
        //   F13  F14  F15  (mute / encoder switch)
        //   F16  F17  F18
        //   F19  F20  F21  studio_unlock
        //  Encoder rotate = volume down / up
        //  Tap the "0" key here to unlock ZMK Studio for editing.
        // ------------------------------------------------------------------

        layer_0 {
            bindings = <
&kp LC(NUMBER_1)  &trans  &trans  &trans
&kp LC(NUMBER_2)  &trans  &trans
&kp LC(NUMBER_3)  &trans  &to 1   &trans
            >;
        };

        layer_1 {
            bindings = <
&kp LC(Z)  &trans  &trans  &trans
&kp LC(C)  &trans  &trans
&kp LC(V)  &trans  &to 0   &trans
            >;
        };
    };
};
